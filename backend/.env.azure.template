# Acredittia - Configuración Azure de Producción

# --- Base de datos (Azure Database for PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://pgadmin:<TU_PASSWORD_AQUI>@acredittia-pg.postgres.database.azure.com:5432/acredittia?sslmode=require
SCHEMA_DIR=/schema
SCHEMA_VERSION_ESPERADA=6
DB_RLS_ENABLED=true

# --- Autenticación ---
JWT_SECRET=<TU_JWT_SECRET_AQUI>
CORS_ORIGINS=https://acredittia.vercel.app,http://localhost:3000
PUBLIC_BASE_URL=https://acredittia-api.proudcoast-43092667.northcentralus.azurecontainerapps.io

# --- Almacenamiento (Azure Blob Storage) ---
STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT=acredittiablobs
AZURE_BLOB_CONTAINER=docs

# --- Cola de trabajos (Redis interno Container Apps) ---
QUEUE_BACKEND=celery
REDIS_URL=redis://acredittia-redis:6379/0

# --- Cifrado de credenciales (Azure Key Vault) ---
JWE_BACKEND=keyvault
AZURE_KEYVAULT_URL=https://acredittia-kv.vault.azure.net/

# --- IA ---
IA_BACKEND=simulada
