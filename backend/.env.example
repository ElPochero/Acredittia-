# Acredittia Backend - Variables de entorno de ejemplo (copiar a backend/.env)

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/acredittia
SCHEMA_DIR=../modelo_datos
SCHEMA_VERSION_ESPERADA=20
DB_RLS_ENABLED=true

# --- Autenticación ---
JWT_SECRET=<TU_JWT_SECRET_AQUI>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8000
APP_URL=http://localhost:3000

# --- Almacenamiento local ---
STORAGE_BACKEND=local
STORAGE_DIR=./data/uploads

# --- Cola de trabajos local ---
QUEUE_BACKEND=inproc
# REDIS_URL=redis://localhost:6379/0

# --- Cifrado local ---
JWE_BACKEND=local
KEYS_DIR=./data/keys

# --- IA ---
IA_BACKEND=gemini
GEMINI_API_KEY=<TU_GEMINI_API_KEY_AQUI>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Notificaciones (SMTP Gmail con App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<TU_CORREO_AQUI>@gmail.com
SMTP_PASSWORD=<TU_APP_PASSWORD_SMTP_AQUI>
EMAIL_FROM=<TU_CORREO_AQUI>@gmail.com
