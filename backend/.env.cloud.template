# =============================================================================
# Acredittia - Plantilla Multi-Cloud de Producción
# =============================================================================
# Descomente el bloque del proveedor objetivo (Azure, AWS, GCP o S3-Compatible).
# En APP_ENV=production los backends `local` y secretos débiles fallan al arranque.

APP_ENV=production
DATABASE_URL=postgresql+psycopg://acredittia_app:<PASSWORD>@<DB_HOST>:5432/acredittia?sslmode=require
WORKER_DATABASE_URL=postgresql+psycopg://acredittia_worker:<PASSWORD>@<DB_HOST>:5432/acredittia?sslmode=require
SCHEMA_DIR=/schema
SCHEMA_VERSION_ESPERADA=20
DB_APPLY_SCHEMA_ON_START=false
DB_RLS_ENABLED=true

JWT_SECRET=<MINIMO_32_BYTES_ALEATORIOS>
CORS_ORIGINS=https://app.acredittia.cl
PUBLIC_BASE_URL=https://api.acredittia.cl
APP_URL=https://app.acredittia.cl

QUEUE_BACKEND=celery
REDIS_URL=redis://<REDIS_HOST>:6379/0

# -----------------------------------------------------------------------------
# OPCIÓN A: Microsoft Azure (Container Apps + Blob Storage + Key Vault)
# -----------------------------------------------------------------------------
# CLOUD_PROVIDER=azure
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT=acredittiablobs
# AZURE_BLOB_CONTAINER=docs
# JWE_BACKEND=keyvault
# AZURE_KEYVAULT_URL=https://acredittia-kv.vault.azure.net/
# KEYVAULT_KEY_NAME=plataforma-cred

# -----------------------------------------------------------------------------
# OPCIÓN B: Amazon Web Services (ECS/App Runner + S3 + KMS + Secrets Manager)
# -----------------------------------------------------------------------------
# CLOUD_PROVIDER=aws
# AWS_REGION=us-east-1
# STORAGE_BACKEND=aws
# S3_BUCKET=acredittia-docs
# JWE_BACKEND=aws
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:<ACCOUNT_ID>:key/<KEY_UUID>
# SECRET_BACKEND=aws
# AWS_SECRETS_PREFIX=acredittia

# -----------------------------------------------------------------------------
# OPCIÓN C: Google Cloud Platform (Cloud Run + GCS + Cloud KMS + Secret Manager)
# -----------------------------------------------------------------------------
# CLOUD_PROVIDER=gcp
# GCP_PROJECT_ID=<GCP_PROJECT_ID>
# STORAGE_BACKEND=gcp
# GCP_STORAGE_BUCKET=acredittia-docs
# GCP_SERVICE_ACCOUNT_EMAIL=acredittia-api@<GCP_PROJECT_ID>.iam.gserviceaccount.com
# JWE_BACKEND=gcp
# GCP_KMS_KEY_NAME=projects/<GCP_PROJECT_ID>/locations/global/keyRings/acredittia/cryptoKeys/plataforma-cred
# SECRET_BACKEND=gcp

# -----------------------------------------------------------------------------
# OPCIÓN D: S3-Compatible / On-Prem (MinIO, Cloudflare R2, DigitalOcean Spaces)
# -----------------------------------------------------------------------------
# CLOUD_PROVIDER=custom
# STORAGE_BACKEND=s3
# S3_BUCKET=acredittia-docs
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=https://files.acredittia.cl
# S3_ACCESS_KEY_ID=<ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<SECRET_KEY>
# S3_FORCE_PATH_STYLE=true
# JWE_BACKEND=aws
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=<KMS_KEY_ARN>

# --- IA y Notificaciones ---
IA_BACKEND=gemini
GEMINI_API_KEY=<TU_GEMINI_API_KEY>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
EMAIL_FROM=no-reply@acredittia.cl
