# Acredittia - Variables de entorno de ejemplo (copiar a .env y completar valores)
# Ver backend/.env.cloud.template para perfiles completos de producción multi-cloud.

# --- Entorno y Preset Multi-Cloud ---
# APP_ENV: development | test | staging | production
# CLOUD_PROVIDER: local | azure | aws | gcp | custom
APP_ENV=development
CLOUD_PROVIDER=local

# --- Base de datos (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/acredittia
SCHEMA_DIR=/schema
SCHEMA_VERSION_ESPERADA=20
DB_RLS_ENABLED=true

# --- Autenticación ---
JWT_SECRET=<TU_JWT_SECRET_AQUI>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8001
APP_URL=http://localhost:3000

# --- Almacenamiento (local | azure | aws | s3 | gcp) ---
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploads
# AZURE_STORAGE_ACCOUNT=<TU_STORAGE_ACCOUNT_AQUI>
# AZURE_BLOB_CONTAINER=docs
# AWS_REGION=us-east-1
# S3_BUCKET=acredittia-docs
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=<MINIO_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<MINIO_SECRET_KEY>
# S3_FORCE_PATH_STYLE=true
# GCP_PROJECT_ID=<TU_GCP_PROJECT_ID>
# GCP_STORAGE_BUCKET=acredittia-docs

# --- Cola de trabajos (inproc | celery) ---
QUEUE_BACKEND=celery
REDIS_URL=redis://redis:6379/0

# --- Cifrado JWE y Secretos (local | azure | keyvault | aws | gcp) ---
JWE_BACKEND=local
# SECRET_BACKEND=  # Opcional; por defecto hereda JWE_BACKEND
KEYS_DIR=/data/keys
# AZURE_KEYVAULT_URL=https://<tu-keyvault>.vault.azure.net/
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/<id>
# AWS_SECRETS_PREFIX=acredittia
# GCP_KMS_KEY_NAME=projects/<proj>/locations/global/keyRings/acredittia/cryptoKeys/plataforma-cred

# --- IA ---
IA_BACKEND=gemini
GEMINI_API_KEY=<TU_GEMINI_API_KEY_AQUI>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VERIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Notificaciones (SMTP Gmail con App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<TU_CORREO_AQUI>@gmail.com
SMTP_PASSWORD=<TU_APP_PASSWORD_SMTP_AQUI>
EMAIL_FROM=<TU_CORREO_AQUI>@gmail.com
